# Image Docker Hub
DOCKER_IMAGE=sankarej/lecture-et-bouture:latest

# Base — DATABASE_URL et MINIO_ENDPOINT/PORT sont overridés dans docker-compose
DATABASE_URL=postgresql://leb:leb@localhost:5432/leb
AUTH_SECRET=<openssl rand -base64 33>
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
PREVIEW_SECRET=<openssl rand -base64 20>

# Anti-spam formulaires publics (contact, avis visiteur, disponibilité)
# ALTCHA — self-hosted, pas de service tiers
ALTCHA_HMAC_SECRET=<openssl rand -base64 33>

# Google Books API (catalogue public — browse, search, discovery)
# https://console.cloud.google.com → Books API → Credentials
GOOGLE_BOOKS_API_KEY=

# Boutique (config publique)
NEXT_PUBLIC_STORE_NAME=Lecture & Bouture
NEXT_PUBLIC_STORE_TAGLINE=Cultiver l'esprit, nourrir la terre.
NEXT_PUBLIC_STORE_DESCRIPTION=Boutique hybride livres et boutures végétales.
NEXT_PUBLIC_STORE_URL=https://lectureetbouture.fr
NEXT_PUBLIC_STORE_ADDRESS_STREET=1 rue des Plantes
NEXT_PUBLIC_STORE_ADDRESS_CITY=75000 Paris
NEXT_PUBLIC_STORE_LAT=48.8566
NEXT_PUBLIC_STORE_LNG=2.3522
NEXT_PUBLIC_STORE_LOCALE=fr

# MinIO (stockage images self-hosted)
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=leb
MINIO_PUBLIC_URL=http://localhost:9100/leb

# Email transactionnel (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@lectureetbouture.fr
RESEND_TO_EMAIL=contact@lectureetbouture.fr

# Newsletter (Loops)
LOOPS_API_KEY=

# Analytics (Umami)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_HOST=https://cloud.umami.is

# Import livres BO (inventaire.io ou wikidata)
BOOK_IMPORT_PROVIDER=inventaire

# Wikidata
WIKIDATA_ACCESS_TOKEN=
